#wv .name{font-weight:600;margin:4px 0 6px}
#wv .price{font-family:'Barlow Condensed',sans-serif;font-size:30px;font-weight:700}
#wv .price s{font-size:18px;color:#6b7a88;font-weight:600;margin-left:6px}

#wv .about{background:#0b1b29;color:#fff}
#wv .about .wrap{display:grid;grid-template-columns:1fr 1fr;gap:48px}
#wv .about h2{font-size:clamp(34px,5vw,48px);margin-bottom:16px;color:#fff}
