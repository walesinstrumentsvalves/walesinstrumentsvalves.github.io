#wv .foot a:hover{color:#fff;text-decoration:underline}
#wv .copy{margin-top:32px;font-size:14px;color:#8fa1b1}

@media (max-width:860px){
  #wv .hero .wrap,#wv .about .wrap{grid-template-columns:1fr}
