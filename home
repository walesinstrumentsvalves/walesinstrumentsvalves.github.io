body{overflow-x:clip}
#wv{width:100vw;margin-left:calc(50% - 50vw);margin-top:0;margin-bottom:0;padding:0;font-family:'Barlow',Arial,sans-serif;color:#10202e;background:#f3f5f7;line-height:1.5;font-size:17px;text-align:left;box-sizing:border-box}
